{
  "name": "retroreel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vercel dev --listen 127.0.0.1:5191",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"api/**/*.ts\" local-api.ts vite.config.ts index.html",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"api/**/*.ts\" local-api.ts vite.config.ts index.html",
    "data": "python3 scripts/build_data.py && python3 scripts/seed_redis.py",
    "pin": "python3 scripts/pin_ids.py --write"
  },
  "dependencies": {
    "@upstash/redis": "1.39.0",
    "d3-geo": "3.1.1",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "d3-zoom": "3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "@types/d3-selection": "3.0.12",
    "@types/d3-shape": "3.2.0",
    "@types/d3-zoom": "3.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
