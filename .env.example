# TMDB key (https://www.themoviedb.org/settings/api): the v3 API key or the v4 read access token.
TMDB_API_KEY=
# Any long random string. Open the site once as /#owner=<this key> to add films and review suggestions.
OWNER_KEY=
# The owner's Letterboxd username: the films they log are added to the timeline (api/sync.ts).
OWNER_LETTERBOXD=
# Any long random string, production only: Vercel Cron sends it when it runs /api/sync.
CRON_SECRET=
# Added by Vercel when an Upstash Redis store is connected to the project (`vercel env pull .env.local`).
KV_REST_API_URL=
KV_REST_API_TOKEN=
